# Ключи WooCommerce REST API.
# Для оформления заказа нужны права Read/Write (не Read!).
# Сгенерировать: WooCommerce → Settings → Advanced → REST API → Add key
#   Permissions: Read/Write, User: администратор.
#
# Скопируй этот файл в .env (рядом с package.json), вставь свои ключи и перезапусти `npm run dev`.
# .env НЕ коммитить в git.

VITE_WC_CONSUMER_KEY=ck_сюда_твой_consumer_key
VITE_WC_CONSUMER_SECRET=cs_сюда_твой_consumer_secret
